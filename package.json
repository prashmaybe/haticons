{
  "name": "haticons",
  "version": "1.0.2",
  "description": "A set of beautifully crafted, modular, lightweight web font and SVG icons for Web, iOS, Android, and Desktop apps. Inspired by Ionicons, FontAwesome, and Glyphicons.",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "style": "dist/css/haticons.min.css",
  "sass": "scss/haticons.scss",
  "less": "less/haticons.less",
  "files": [
    "dist",
    "scss",
    "less",
    "index.js",
    "index.mjs",
    "index.d.ts",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "PROVENANCE.md",
    "BUNDLE_SIZE.md"
  ],
  "bin": {
    "haticons": "./bin/haticons.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./react/*": {
      "types": "./dist/react/*.d.ts",
      "import": "./dist/react/*.mjs",
      "require": "./dist/react/*.js",
      "default": "./dist/react/*.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.mjs",
      "require": "./dist/vue/index.js",
      "default": "./dist/vue/index.js"
    },
    "./vue/*": {
      "types": "./dist/vue/*.d.ts",
      "import": "./dist/vue/*.mjs",
      "require": "./dist/vue/*.js",
      "default": "./dist/vue/*.js"
    },
    "./resolver": {
      "types": "./dist/resolver/index.d.ts",
      "import": "./dist/resolver/index.mjs",
      "require": "./dist/resolver/index.js",
      "default": "./dist/resolver/index.js"
    },
    "./css": "./dist/css/haticons.min.css",
    "./css/haticons.css": "./dist/css/haticons.css",
    "./css/haticons.min.css": "./dist/css/haticons.min.css",
    "./css/core.css": "./dist/css/core.css",
    "./css/core.min.css": "./dist/css/core.min.css",
    "./css/categories/*": "./dist/css/categories/*",
    "./categories/*": "./dist/css/categories/*",
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.mjs",
      "require": "./dist/icons/*.js",
      "default": "./dist/icons/*.js"
    },
    "./svg/*": "./dist/svg/*",
    "./data/icons.json": "./dist/data/icons.json",
    "./data/categories.json": "./dist/data/categories.json",
    "./scss/*": "./scss/*",
    "./less/*": "./less/*",
    "./fonts/*": "./dist/fonts/*",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "start": "node scripts/serve.js",
    "serve": "node scripts/serve.js",
    "build": "node scripts/build.js",
    "build:site": "node scripts/build-site.js",
    "build:size": "node scripts/bundle-size.js",
    "test": "node scripts/verify-release.js",
    "prepublishOnly": "npm run test && npm run build && npm run build:size"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prashmaybe/haticons.git"
  },
  "keywords": [
    "haticons",
    "icons",
    "font-icons",
    "webfonts",
    "vector-icons",
    "svg",
    "sass",
    "scss",
    "less",
    "boodoo",
    "boodooframework",
    "pebblebenders",
    "ionicons",
    "fontawesome",
    "glyphicons"
  ],
  "author": {
    "name": "PebbleBenders",
    "url": "https://pebblebenders.com/"
  },
  "license": "GPL-3.0",
  "homepage": "https://haticons.com",
  "bugs": {
    "url": "https://github.com/prashmaybe/haticons/issues"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "less": "^4.9.1",
    "react": "^19.3.1",
    "sass": "^1.106.1",
    "svg2ttf": "^6.1.0",
    "ttf2eot": "^3.1.0",
    "ttf2woff": "^3.0.0",
    "vue": "^3.5.44",
    "woff2": "^1.0.0"
  }
}
